class Student:

    def __init__(self, name, marks):
        self.name = name
        self.__marks = marks

    def set_marks(self, marks):
        if 0 <= marks <= 100:
            self.__marks = marks
        else:
            print("Invalid marks")

    def get_marks(self):
        return self.__marks


student = Student("Poojitha", 85)

print("Name:", student.name)
print("Marks:", student.get_marks())

student.set_marks(95)

print("Updated Marks:", student.get_marks())
