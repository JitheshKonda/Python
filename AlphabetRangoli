import string

def print_rangoli(size):
    alphabet = string.ascii_lowercase
    lines = []
 
    for i in range(size):
        current_chars = alphabet[i:size]
        row = "-".join(current_chars[::-1] + current_chars[1:])
        lines.append(row.center(4 * size - 3, '-'))
 
    total_rangoli = lines[::-1] + lines[1:]
    print("\n".join(total_rangoli))

if __name__ == '__main__':
    n = int(input())
    print_rangoli(n)


